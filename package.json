{
  "name": "suelr-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first multimodal AI studio",
  "author": "SueLr",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "install:all": "npm install --prefix backend",
    "start": "node scripts/start-dev.mjs",
    "dev:local-web": "node scripts/start-dev.mjs",
    "build:local-web": "node scripts/build-local-web.mjs",
    "start:local-web": "node scripts/start-local-web.mjs",
    "dev": "concurrently -n frontend,backend -c blue,green \"vite\" \"npm run dev --prefix backend\"",
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "check:workflow-store": "node scripts/check-workflow-store-structure.mjs",
    "check:docs": "node scripts/check-release-docs.mjs",
    "check:runtime-baseline": "node scripts/check-runtime-baseline.mjs",
    "check:test-surface": "node scripts/check-test-surface.mjs",
    "check:repo-hygiene": "node scripts/check-repo-hygiene.mjs",
    "check:dead-code": "knip --config knip.jsonc --include files,dependencies,unlisted,unresolved,duplicates && knip --directory backend --config knip.jsonc --include files,dependencies,unlisted,unresolved,duplicates",
    "check:encoding": "node scripts/check-encoding.mjs",
    "fix:encoding": "node scripts/fix-encoding.mjs",
    "lint": "biome check src/ backend/src/",
    "lint:fix": "biome check --write src/ backend/src/",
    "format": "biome format --write src/ backend/src/",
    "format:check": "biome format src/ backend/src/",
    "typecheck": "npx tsc --noEmit && npm run typecheck --prefix backend",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test": "npm run test:backend",
    "test:backend": "npm run test --prefix backend",
    "build": "vite build",
    "check": "npm run check:workflow-store && npm run check:docs && npm run check:runtime-baseline && npm run check:test-surface && npm run check:repo-hygiene && npm run check:dead-code && npm run check:encoding && npm run typecheck && npm run test:unit && npm run build && npm run test:backend",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@xyflow/react": "^12.11.1",
    "fflate": "0.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "22.19.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.3",
    "electron": "^41.9.0",
    "electron-builder": "^26.15.3",
    "knip": "^6.18.0",
    "tailwindcss": "^4.3.1",
    "typescript": "5.9.3",
    "vite": "^8.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.suelr.studio",
    "productName": "SueLr Studio",
    "artifactName": "SueLr-Studio.${ext}",
    "copyright": "Copyright (c) 2026 SueLr",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "build/icon.icns",
      "backend/**/*",
      "src/shared/workflow/**/*",
      "package.json",
      "!node_modules/**/*",
      "!backend/package-lock.json",
      "!backend/node_modules/.package-lock.json",
      "!backend/tests/**/*",
      "!backend/.playwright{,/**/*}",
      "!backend/node_modules/**/{test,tests,docs,.github}/**/*",
      "!backend/node_modules/**/test*.js",
      "!backend/node_modules/**/tests*.js",
      "!backend/node_modules/**/*.md",
      "!backend/node_modules/**/*.markdown",
      "!backend/node_modules/**/{README,CHANGELOG,HISTORY,LICENSE,NOTICE}*"
    ],
    "asarUnpack": [
      "backend/node_modules/**/*.node",
      "backend/node_modules/sharp/**/*",
      "backend/node_modules/@img/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "legalTrademarks": "SueLr Studio",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
