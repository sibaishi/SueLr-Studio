VITE_API_BASE=/api
APP_PORT=3001
APP_HOST=127.0.0.1
# Local/private provider URLs are allowed automatically while APP_HOST is loopback.
# If you expose APP_HOST beyond localhost and still need a LAN provider, opt in explicitly.
# APP_ALLOW_PRIVATE_PROVIDER_URLS=false
# APP_CONFIG_DIR defaults to the current user's system config directory when omitted.
# Use an absolute path when you want to pin config, secrets, uploads, generated files, and logs elsewhere.
# APP_CONFIG_DIR=C:\Users\you\AppData\Roaming\SueLr-Studio
# APP_STORAGE_DIR is still supported for older deployments, but APP_CONFIG_DIR takes precedence.
# APP_STORAGE_DIR=storage
# Comma-separated allowed frontend origins.
# Set this explicitly for LAN access or split frontend/backend deployments.
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
